% arxiv.sty -- lightweight arXiv-style preprint layout.
% Self-contained; uses only standard packages so it compiles out of the box.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{arxiv}[2026/05/30 v1.0 arXiv-style preprint layout]
\ProcessOptions\relax

\RequirePackage[T1]{fontenc}
\RequirePackage{lmodern}
\RequirePackage[letterpaper,margin=1in]{geometry}
\RequirePackage{parskip}
\RequirePackage{fancyhdr}
\RequirePackage{titlesec}
\RequirePackage{graphicx}
\RequirePackage{amsmath,amssymb}
\RequirePackage{booktabs}
\RequirePackage{xcolor}
\RequirePackage[colorlinks=true,allcolors=blue,breaklinks=true]{hyperref}

% --- running header / footer ---------------------------------------------
\newcommand{\runningheadertext}{A Preprint}
\newcommand{\runningheader}[1]{\renewcommand{\runningheadertext}{#1}}
\pagestyle{fancy}
\fancyhf{}
\renewcommand{\headrulewidth}{0.4pt}
\fancyhead[L]{\small\scshape\runningheadertext}
\fancyhead[R]{\small\thepage}
\fancypagestyle{plain}{%
  \fancyhf{}\renewcommand{\headrulewidth}{0pt}\fancyfoot[C]{\small\thepage}}

% --- section headings -----------------------------------------------------
\titleformat{\section}{\large\bfseries}{\thesection}{0.6em}{}
\titleformat{\subsection}{\normalsize\bfseries}{\thesubsection}{0.6em}{}
% Sub-subsections are bold italic, to distinguish them from the bold-upright
% subsection headings one level up (article's default leaves them identical).
\titleformat{\subsubsection}{\normalsize\bfseries\itshape}{\thesubsubsection}{0.6em}{}
\titlespacing*{\section}{0pt}{1.4ex plus 1ex minus .2ex}{0.8ex plus .2ex}

% --- title block ----------------------------------------------------------
\renewcommand{\maketitle}{%
  \thispagestyle{plain}%
  \begin{center}%
    {\LARGE\bfseries\@title\par}%
    \vskip 1.4em%
    {\large\lineskip .5em\@author\par}%
    \vskip 1.0em%
    {\normalsize\@date\par}%
  \end{center}%
  \vskip 1.6em%
}

% --- abstract -------------------------------------------------------------
\renewenvironment{abstract}{%
  \begin{center}\large\bfseries Abstract\end{center}%
  \begin{quotation}\small\noindent\ignorespaces
}{%
  \end{quotation}\vskip 1em\hrule\vskip 1.2em%
}

% keywords helper
\newcommand{\keywords}[1]{\par\vskip 0.4em\noindent\small\textbf{Keywords:} #1}
